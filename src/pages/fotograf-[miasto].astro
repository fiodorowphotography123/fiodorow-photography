                format="webp"
                widths={[400, 800]}
                sizes="(max-width: 1024px) 50vw, 25vw"
              />
            )
          }
          {
            typeof city.gridImages[1] === "string" ? (
              <img
                src={city.gridImages[1]}
                alt={`Fotografia portretowa w ${city.nameLocative}`}
                class="w-full aspect-[2/3] object-cover mt-8 rounded-sm"
                loading="lazy"
              />
            ) : (
              <Image
                src={city.gridImages[1]}
                alt={`Fotografia portretowa w ${city.nameLocative}`}
                class="w-full aspect-[2/3] object-cover mt-8 rounded-sm"
                loading="lazy"
                quality={80}
                format="webp"
                widths={[400, 800]}
                sizes="(max-width: 1024px) 50vw, 25vw"
              />
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Opinie par (prawdziwe recenzje klientów) -->
  <section class="py-20 md:py-32 section-cream">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="text-center mb-12 reveal reveal-up">
        <span class="text-olive text-xs font-bold tracking-[0.2em] uppercase mb-4 block">
          Opinie
        </span>
        <h2 class="section-title">Co mówią pary, które nam zaufały</h2>
      </div>

      <div
        class="columns-1 md:columns-2 lg:columns-3 gap-6 [&>*]:mb-6 [&>*]:break-inside-avoid reveal reveal-up reveal-d1"
      >
        {
          reviews.map((review) => (
            <div class="bg-white p-8 rounded-sm border border-charcoal/10">
              <div class="flex gap-1 text-olive mb-4">
                {Array.from({ length: 5 }).map(() => (
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.958a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.367 2.446a1 1 0 00-.364 1.118l1.287 3.958c.3.922-.755 1.688-1.54 1.118l-3.366-2.446a1 1 0 00-1.176 0l-3.366 2.446c-.784.57-1.838-.196-1.539-1.118l1.287-3.958a1 1 0 00-.364-1.118L2.98 9.385c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.95-.69l1.286-3.958z" />
                  </svg>
                ))}
              </div>
              <p class="text-charcoal-light text-sm leading-relaxed italic mb-6">
                „{review.quote}"
              </p>
              <p class="text-charcoal text-sm font-medium">
                {review.author}
                {review.date && (
                  <span class="text-charcoal-light font-normal"> · {review.date}</span>
                )}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Portfolio Gallery — zdjęcia z Sanity (okładki + kadry z realizacji) -->
  <section class="py-20 md:py-32 bg-white">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="text-center mb-12 reveal reveal-up">
        <span class="text-olive text-xs font-bold tracking-[0.2em] uppercase mb-4 block">
          Portfolio
        </span>
        <h2 class="section-title">Ostatnie realizacje</h2>
        <p class="text-charcoal-light text-sm max-w-lg mx-auto mt-4">
          Zobaczcie kadry z prawdziwych ślubów — naturalne emocje, światło i
          chwile, które zostają na zawsze.
        </p>
      </div>

      <!-- Justified grid: pełne rzędy wypełniają 100% szerokości (flex-grow ∝
           proporcje), równa wysokość w rzędzie, zero kadrowania. Ostatni
           niepełny rząd trzyma skalę pełnych rzędów i jest wyśrodkowany. -->
      {
        galleryImages.length > 0 ? (
          <div class="flex flex-col gap-3 md:gap-4 reveal reveal-up reveal-d1">
            {galleryRows.map((row) => (
              <div class={`flex gap-3 md:gap-4 ${row.full ? "" : "justify-center"}`}>
                {row.items.map((g) => (
                  <a
                    href="/portfolio"
                    class="block overflow-hidden rounded-sm bg-cream-dark transition-opacity duration-300 hover:opacity-90"
                    style={
                      row.full
                        ? `flex-grow:${g.ar}; flex-basis:0; aspect-ratio:${g.ar};`
                        : `width:${((g.ar / TARGET_ROW_AR) * 100).toFixed(2)}%; aspect-ratio:${g.ar};`
                    }
                  >
                    <img
                      src={urlFor(g.image).width(800).quality(72).url()}
                      alt={`Fotografia ślubna ${city.nameLocative} — realizacja`}
                      loading="lazy"
                      class="w-full h-full object-cover"
                    />
                  </a>
                ))}
              </div>
            ))}
          </div>
        ) : (
          <div class="flex flex-col gap-3 md:gap-4 reveal reveal-up reveal-d1">
            {buildJustifiedRows(
              [1.5, 0.75, 1.3, 1.0, 1.6, 0.8, 1.2, 1.7, 0.85, 1.4, 1.1, 0.9].map((ar) => ({ ar }))
            ).map((row) => (
              <div class={`flex gap-3 md:gap-4 ${row.full ? "" : "justify-center"}`}>
                {row.items.map((g) => (
                  <div
                    class="rounded-sm bg-cream-dark flex items-center justify-center"
                    style={
                      row.full
                        ? `flex-grow:${g.ar}; flex-basis:0; aspect-ratio:${g.ar};`
                        : `width:${((g.ar / TARGET_ROW_AR) * 100).toFixed(2)}%; aspect-ratio:${g.ar};`
                    }
                  >
                    <svg class="w-10 h-10 text-olive/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.822 1.316z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0z" />
                    </svg>
                  </div>
                ))}
              </div>
            ))}
          </div>
        )
      }

      <div class="text-center mt-12 reveal reveal-up">
        <a href="/portfolio" class="btn-primary inline-block">
          Zobacz całe portfolio
        </a>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-20 md:py-32 section-cream">
