const { city, miasto } = Astro.props;

if (!city) {
  return Astro.redirect("/");
}

// Galeria zdjęć z Sanity (okładki + kadry z realizacji). Fallback: placeholdery.
let galleryImages: { image: any; ar: number }[] = [];
try {
  galleryImages = await getLandingGallery(12);
} catch (e) {
  galleryImages = [];
}

// Justified grid: grupuj w rzędy o sumie proporcji ~TARGET_ROW_AR — każdy
// pełny rząd wypełnia 100% szerokości (flex-grow ∝ ar), wysokość w rzędzie
// równa, zdjęcia w oryginalnych proporcjach (zero kadrowania).
const TARGET_ROW_AR = 3.2;
function buildJustifiedRows(items: { ar: number; [k: string]: any }[]) {
  const rows: { items: typeof items; full: boolean }[] = [];
  let current: typeof items = [];
  let sum = 0;
  for (const it of items) {
    current.push(it);
    sum += it.ar;
    if (sum >= TARGET_ROW_AR) {
      rows.push({ items: current, full: true });
      current = [];
      sum = 0;
    }
  }
  if (current.length) rows.push({ items: current, full: false });
  return rows;
}
const galleryRows = buildJustifiedRows(galleryImages);

