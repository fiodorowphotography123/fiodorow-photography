          <p class="text-charcoal-light text-sm leading-relaxed">
            {city.serviceDescriptions.wedding}
          </p>
        </div>

        <div class="bg-white p-8 text-center reveal reveal-up reveal-d1">
          <div
            class="w-16 h-16 mx-auto mb-6 flex items-center justify-center border border-charcoal/20"
          >
            <svg
              class="w-8 h-8 text-olive"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
              ></path>
            </svg>
          </div>
          <h3 class="font-serif text-lg tracking-[0.15em] uppercase mb-4">
