      </p>
      <div
        class="flex flex-col sm:flex-row gap-4 justify-center reveal reveal-up reveal-d2"
      >
        <a
          href="tel:+48660872121"
          class="btn-primary border-white text-white hover:bg-white hover:text-charcoal"
        >
          +48 660 872 121
        </a>
        <a
          href="/kontakt"
          class="btn-primary border-white text-white hover:bg-white hover:text-charcoal"
        >
          Napisz do nas
        </a>
        <a
          href="/portfolio"
          class="btn-primary border-white/50 text-white/90 hover:bg-white hover:text-charcoal"
        >
          Zobacz portfolio
        </a>
      </div>
    </div>
  </section>

  <!-- Odstęp pod sticky pasek (tylko mobile) -->
  <div class="h-14 md:hidden"></div>

  <Footer />

  <!-- Sticky CTA (tylko mobile) — telefon liczy się jako event Contact -->
