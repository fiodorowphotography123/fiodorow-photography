      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-20 md:py-32 section-cream">
    <div class="max-w-4xl mx-auto px-6 md:px-12">
      <div class="text-center mb-16 reveal reveal-up">
        <span
          class="text-olive text-xs font-bold tracking-[0.2em] uppercase mb-4 block"
          >FAQ</span
        >
        <h2 class="section-title">
          Najczęstsze pytania – fotograf w {city.nameLocative}
        </h2>
      </div>

      <div class="space-y-6">
        {
          city.faq.map((item, index) => (
            <details class="group bg-white p-6 md:p-8 reveal reveal-up">
              <summary class="cursor-pointer list-none flex items-center justify-between gap-4">
                <h3 class="font-serif text-base md:text-lg text-charcoal pr-4">
                  {item.question}
                </h3>
                <span class="text-olive text-2xl font-light flex-shrink-0 transition-transform duration-300 group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="text-charcoal-light text-sm leading-relaxed mt-4 pt-4 border-t border-charcoal/10">
                {item.answer}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Areas Served -->
  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-4xl mx-auto px-6 md:px-12 text-center">
      <div class="reveal reveal-up">
        <span
          class="text-olive text-xs font-bold tracking-[0.2em] uppercase mb-4 block"
          >Zasięg</span
        >
        <h2 class="font-serif text-xl tracking-[0.15em] uppercase mb-4">
          Działamy również w okolicach {city.nameGenitive}
        </h2>
        <p class="text-charcoal-light text-sm mb-8">
          Oprócz {city.nameGenitive} dojeżdżamy na sesje i śluby do okolicznych miejscowości
          oraz odległych miast w całym kraju. Skontaktuj się z nami, a ustalimy szczegóły!
        </p>
      </div>
      <div
        class="flex flex-wrap justify-center gap-4 reveal reveal-fade reveal-d2"
      >
        {
          city.nearbyAreas.map((area) => {
            const path = cityPathMap[area];
            return path ? (
              <a
                href={path}
                class="px-4 py-2 bg-cream-dark text-sm text-charcoal-light rounded-sm hover:bg-olive hover:text-white transition-colors"
              >
                {area}
              </a>
            ) : (
              <span class="px-4 py-2 bg-cream-dark text-sm text-charcoal-light rounded-sm">
                {area}
              </span>
            );
          })
        }
        <span class="px-4 py-2 bg-olive text-sm text-white rounded-sm">
          Cała Polska
        </span>
      </div>
    </div>
  </section>

  <!-- CTA -->
