---
import "../styles/global.css";
import CookieBanner from "../components/CookieBanner.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  breadcrumbs?: { name: string; href: string }[];
  noindex?: boolean;
  /** Ścieżka innej strony, która ma przejąć sygnały SEO tej strony (np. "/").
   *  Używane dla landingów reklamowych, żeby nie konkurowały w Google z główną. */
  canonicalPath?: string;
}

const {
  title,
  description = "Fiodorow Photography - Profesjonalna fotografia ślubna i portretowa. Siedlce, Białystok, Warszawa.",
  image = "/og-image.jpg",
  breadcrumbs,
  noindex = false,
  canonicalPath,
} = Astro.props;

const canonicalURL = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);

const breadcrumbSchema = breadcrumbs
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Strona główna",
          item: "https://fiodorowphotography.pl/",
        },
        ...breadcrumbs.map((crumb, i) => {
          const isLast = i === breadcrumbs.length - 1;
          return {
            "@type": "ListItem",
            position: i + 2,
            name: crumb.name,
            ...(isLast ? {} : { item: `https://fiodorowphotography.pl${crumb.href}` }),
          };
        }),
      ],
    }
  : null;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="A8sAQwFGGkEVF254rrUXzuEDqUSXJGU1cUgY4rgii9A" />
    <meta name="facebook-domain-verification" content="v21h0d04rguz9dhg7ov9sjyzsialro" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Preconnect -->
    <link rel="preconnect" href="https://cdn.sanity.io" />

    <!-- Fonts loaded locally via Fontsource -->

    <title>{title}</title>

    <meta name="generator" content={Astro.generator} />

    <slot name="head" />

    <!-- Schema.org — LocalBusiness (typ „Photographer" nie istnieje w schema.org) -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "@id": "https://fiodorowphotography.pl/#photographer",
        name: "Fiodorow Photography | Fotografia Ślubna",
        image: new URL(image, Astro.site).href,
        logo: "https://fiodorowphotography.pl/logo-dark.webp",
        description: description,
        address: {
          "@type": "PostalAddress",
          streetAddress: "Prymasa Stefana Wyszyńskiego",
          addressLocality: "Siedlce",
          addressRegion: "Mazowieckie",
          postalCode: "08-110",
          addressCountry: "PL",
        },
        geo: {
          "@type": "GeoCoordinates",
          latitude: 52.1676,
          longitude: 22.2903,
        },
        priceRange: "$$",
        telephone: "+48 660 872 121",
        url: "https://fiodorowphotography.pl",
        hasMap: "https://maps.google.com/?cid=1555365222895602722",
        areaServed: [
          { "@type": "City", name: "Siedlce" },
          { "@type": "City", name: "Warszawa" },
          { "@type": "City", name: "Białystok" },
          { "@type": "City", name: "Łuków" },
          { "@type": "City", name: "Mińsk Mazowiecki" },
          { "@type": "City", name: "Sokołów Podlaski" },
          { "@type": "City", name: "Węgrów" },
          { "@type": "City", name: "Garwolin" },
        ],
        openingHoursSpecification: {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday",
            "Saturday",
            "Sunday",
          ],
          opens: "00:00",
          closes: "23:59",
        },
        sameAs: [
          "https://maps.google.com/?cid=1555365222895602722",
          "https://www.instagram.com/fiodorow_photography",
          "https://www.facebook.com/fiodorowphotography",
        ],
      })}
    />
    {
      breadcrumbSchema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(breadcrumbSchema)}
        />
      )
    }
  </head>
  <body class="antialiased">
    <slot />
    <CookieBanner />

    <!-- Ruch wewnętrzny — wyłącznik analityki.
         GA4 ma w panelu filtr ruchu wewnętrznego po IP, ale API go nie wystawia,
         a filtr po IP i tak nie działa na danych komórkowych. Robimy to tutaj:

         • podgląd (localhost, *.vercel.app) NIGDY nie wysyła zdarzeń,
         • własne urządzenie wyłączasz raz: fiodorowphotography.pl/?ga-off=1
           (z powrotem: /?ga-on=1). Flaga siedzi w localStorage danej przeglądarki,
           więc zrób to na każdym urządzeniu, z którego testujesz stronę. -->
    <script is:inline>
      (function () {
        try {
          var params = new URLSearchParams(location.search);
          if (params.has('ga-off')) localStorage.setItem('analytics-opt-out', '1');
          if (params.has('ga-on')) localStorage.removeItem('analytics-opt-out');
          var host = location.hostname;
          var isProd = host === 'fiodorowphotography.pl' || host === 'www.fiodorowphotography.pl';
          window.__NO_ANALYTICS =
            !isProd || localStorage.getItem('analytics-opt-out') === '1';
        } catch (e) {
          window.__NO_ANALYTICS = false; // awaria localStorage nie może zabić pomiaru
        }
      })();
    </script>

    <!-- Google Consent Mode v2 — default denied before user consent -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        'analytics_storage': 'denied',
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'wait_for_update': 500
      });

      // Consent Mode v2 (advanced): load GA4 on every page so it can send
      // cookieless pings for modeling even before the user accepts. No cookies
      // are stored until consent is granted (RODO/GDPR compliant).
      // Pomijane dla ruchu wewnętrznego — gtag() zostaje zdefiniowany jako
      // kolejka do dataLayer, więc późniejsze wywołania są nieszkodliwe.
      if (!window.__NO_ANALYTICS) (function () {
        var ga = document.createElement('script');
        ga.src = 'https://www.googletagmanager.com/gtag/js?id=G-YVBD3JPM7N';
        ga.async = true;
        document.head.appendChild(ga);
        gtag('js', new Date());
        gtag('config', 'G-YVBD3JPM7N');
      })();

      // Google Ads — tag remarketingu i atrybucji (AW-...).
      // Konwersji NIE wysyłamy stąd osobnym zdarzeniem: konto ma podpięte GA4,
      // więc Ads bierze je z importu kluczowych zdarzeń GA4 (generate_lead,
      // klik_kontakt). Consent Mode pilnuje zgód (ad_storage itd.).
      window.GOOGLE_ADS = { id: "AW-18308982086" };
      if (window.GOOGLE_ADS.id && !window.__NO_ANALYTICS) {
        gtag('config', window.GOOGLE_ADS.id);
      }

      // Returning visitor who already consented → restore granted state.
      if (localStorage.getItem('cookies-accepted')) {
        gtag('consent', 'update', {
          'analytics_storage': 'granted',
          'ad_storage': 'granted',
          'ad_user_data': 'granted',
          'ad_personalization': 'granted'
        });
      }
    </script>

    <!-- Meta Pixel (Facebook + Instagram Ads) — RODO/Consent-friendly.
         UŚPIONY do czasu wklejenia Pixel ID. Gdzie go wziąć: Meta Events
         Manager → Źródła danych → Twój zestaw → skopiuj ID (same cyfry).
         Wklej poniżej w id: "..." i to wszystko — reszta działa sama. -->
    <script is:inline>
      window.META_PIXEL = { id: "1340303074209336" }; // Piksel „fiodorow strona" (własność konta rekl. 151668474985954)
      if (window.META_PIXEL.id && !window.__NO_ANALYTICS) {
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');

        // Ustaw zgodę RAZ, na podstawie znanego stanu (bez revoke→grant w jednym
        // ticku, co myli Meta Pixel Helper). RODO: brak zgody = 'revoke'.
        var accepted = !!localStorage.getItem('cookies-accepted');
        fbq('consent', accepted ? 'grant' : 'revoke');
        fbq('init', window.META_PIXEL.id);
        if (accepted) {
          fbq('track', 'PageView');
        }
        // Jeśli jeszcze nie zaakceptował — PageView poleci w grantConsent()
        // (poniżej), zaraz po kliknięciu „Akceptuję".
      }
    </script>
    <script>
      // Vercel Analytics — bezcookiowa, nie zapisuje nic na urządzeniu (identyfikacja
      // to hash z żądania, kasowany po 24 h), więc art. 5(3) ePrivacy / PKE jej nie
      // dotyczy i nie wymaga zgody. Ładujemy zawsze — to jedyne rzetelne źródło
      // liczby wejść (GA4 raportuje wyłącznie użytkowników, którzy zaakceptowali).
      function loadVercelAnalytics() {
        if ((window as any).__NO_ANALYTICS) return;
        if (document.querySelector('[data-analytics-loaded]')) return;
        const va = document.createElement('script');
        va.src = '/_vercel/insights/script.js';
        va.defer = true;
        va.dataset.analyticsLoaded = '';
        document.head.appendChild(va);
        const si = document.createElement('script');
        si.src = '/_vercel/speed-insights/script.js';
        si.defer = true;
        document.head.appendChild(si);
      }
      loadVercelAnalytics();

      // Update consent to granted once the user accepts cookies.
      function grantConsent() {
        gtag('consent', 'update', {
          'analytics_storage': 'granted',
          'ad_storage': 'granted',
          'ad_user_data': 'granted',
          'ad_personalization': 'granted'
        });
        // Meta Pixel — odblokuj i policz odsłonę po zgodzie użytkownika.
        // PageView PO 'grant' (pierwsza wizyta: klik „Akceptuję").
        const fbq = (window as any).fbq;
        if (typeof fbq === 'function') {
          fbq('consent', 'grant');
          fbq('track', 'PageView');
        }
      }

      // Odmowa — trzyma GA4/Ads/Meta w stanie denied także wtedy, gdy użytkownik
      // wcześniej zgodę wyraził i teraz ją wycofuje.
      function denyConsent() {
        gtag('consent', 'update', {
          'analytics_storage': 'denied',
          'ad_storage': 'denied',
          'ad_user_data': 'denied',
          'ad_personalization': 'denied'
        });
        const fbq = (window as any).fbq;
        if (typeof fbq === 'function') {
          fbq('consent', 'revoke');
        }
      }

      document.addEventListener('cookies-accepted', grantConsent);
      document.addEventListener('cookies-rejected', denyConsent);
    </script>

    <!-- klik_kontakt — kliknięcie w numer telefonu lub e-mail (dowolne miejsce) -->
    <script is:inline>
      (function () {
        if (window.__klikKontaktBound) return;
        window.__klikKontaktBound = true;
        document.addEventListener('click', function (e) {
          var link = e.target && e.target.closest
            ? e.target.closest('a[href^="tel:"], a[href^="mailto:"]')
            : null;
          if (!link || typeof window.gtag !== 'function') return;
          var href = link.getAttribute('href') || '';
          var method = href.indexOf('tel:') === 0 ? 'telefon' : 'email';
          window.gtag('event', 'klik_kontakt', { method: method });
          // Meta Pixel — standardowe zdarzenie Contact (telefon/mail).
          if (typeof window.fbq === 'function') {
            window.fbq('track', 'Contact', { method: method });
          }
        });
      })();
    </script>

    <!-- Global Scroll-Reveal Animation Observer -->
    <script>
      const initRevealObserver = () => {
        const revealElements = Array.from(document.querySelectorAll(".reveal"));
        if (!revealElements.length) return;

        let ticking = false;

        const revealVisibleElements = () => {
          const triggerLine = window.innerHeight * 0.82;

          revealElements.forEach((el) => {
            if (el.classList.contains("active")) return;

            const rect = el.getBoundingClientRect();
            if (rect.top <= triggerLine) {
              el.classList.add("active");
            }
          });

          ticking = false;
        };

        const requestReveal = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(revealVisibleElements);
        };

        requestReveal();
        window.addEventListener("scroll", requestReveal, { passive: true });
        window.addEventListener("resize", requestReveal);
      };

      const scheduleRevealObserver = () => {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            window.setTimeout(initRevealObserver, 80);
          });
        });
      };

      // Run on initial load
      document.addEventListener("DOMContentLoaded", scheduleRevealObserver);

      // Re-run on Astro page navigation (View Transitions)
      document.addEventListener("astro:page-load", scheduleRevealObserver);
    </script>
  </body>
</html>
